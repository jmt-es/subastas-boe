GEMINI_API_KEY=tu_api_key_de_gemini_aqui
OPENROUTER_API_KEY=
MONGODB_URI=mongodb+srv://...
BLOB_READ_WRITE_TOKEN=

# Modo manual por cookies
BOE_SESSID=
BOE_SIMPLESAML=

# Modo automatizable por login + OTP del BOE
BOE_LOGIN_USER=
BOE_LOGIN_PASSWORD=
BOE_ADMIN_TOKEN=
CRON_SECRET=

# Gmail por IMAP + App Password (preferido para no depender de refresh tokens OAuth)
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
GMAIL_IMAP_HOST=imap.gmail.com
GMAIL_IMAP_PORT=993
GMAIL_IMAP_MAILBOX=INBOX

# Gmail API OAuth (fallback si no usas IMAP)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER_ID=me

# Opcional: afina la busqueda si usas una cuenta dedicada para BOE
BOE_GMAIL_QUERY=from:noresponder-subastas@boe.es newer_than:2d
